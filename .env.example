# ==========================================
# MEDISINC-IA - CONFIGURACIÓN DE ENTORNO
# ==========================================

# Configuración General del Servidor Backend
PORT=8000
ENVIRONMENT=development

# Supabase (Base de Datos PostgreSQL, Autenticación y RLS)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu_supabase_service_role_key

# Llaves de Cifrado y Seguridad (AES-256-GCM y HMAC Pepper)
AES_SECRET_KEY=tu_clave_secreta_aes_256_32_bytes_aqui
HMAC_PEPPER_KEY=tu_clave_pepper_hmac_aqui

# Proveedor de Inteligencia Artificial (gemini, groq, openai)
AI_PROVIDER=gemini
GEMINI_API_KEY=tu_gemini_api_key
GROQ_API_KEY=tu_groq_api_key

# Upstash Redis & QStash (Procesamiento Asíncrono y Rate Limiting)
UPSTASH_REDIS_REST_URL=https://tu-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=tu_upstash_redis_token
